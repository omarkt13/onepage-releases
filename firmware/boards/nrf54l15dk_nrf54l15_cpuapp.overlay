/*
 * nRF54L15 DK for development. The DK's MX25R64 holds books. The display,
 * touch controller, fuel gauge and haptic driver are optional wires to the
 * DK headers; the firmware logs each missing part and runs without it.
 *
 * DK wiring (all optional):
 *   Display  SPIM00 shared with MX25R64: SCK P2.01, MOSI P2.02,
 *            CS P0.00, DC P0.01, RST P0.02, BUSY P0.03
 *   I2C22    SDA P1.06, SCL P1.07 (UART20 flow control is off)
 *   Touch    RDY P1.11
 *   Charger  STAT1 P1.12, STAT2 P1.15
 *   Button   DK Button 0 is the power button
 *   LED      DK LED 1 (PWM20 on P1.10) is the status LED
 */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		nordic,pm-ext-flash = &mx25r64;
		onepage,display = &epd;
		onepage,touch = &touch;
		onepage,charger = &charger;
	};

	charger: charger {
		compatible = "microchip,mcp73833-status";
		stat1-gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		stat2-gpios = <&gpio1 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};

&pinctrl {
	uart20_default_noflow: uart20_default_noflow {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
			bias-pull-up;
		};
	};
	uart20_sleep_noflow: uart20_sleep_noflow {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>, <NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};
	i2c22_default: i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 6)>, <NRF_PSEL(TWIM_SCL, 1, 7)>;
		};
	};
	i2c22_sleep: i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 6)>, <NRF_PSEL(TWIM_SCL, 1, 7)>;
			low-power-enable;
		};
	};
};

&uart20 {
	pinctrl-0 = <&uart20_default_noflow>;
	pinctrl-1 = <&uart20_sleep_noflow>;
};

&nfct {
	status = "okay";
};

&spi00 {
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>, <&gpio0 0 GPIO_ACTIVE_LOW>;

	epd: epd@1 {
		compatible = "onepage,epd-uc81xx";
		reg = <1>;
		spi-max-frequency = <8000000>;
		width = <528>;
		height = <792>;
		dc-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
	};
};

&i2c22 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,concat-buf-size = <64>;

	touch: iqs7222a@44 {
		compatible = "azoteq,iqs7222a";
		reg = <0x44>;
		rdy-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};

	fuel_gauge: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
	};

	haptic: drv2605@5a {
		compatible = "ti,drv2605";
		reg = <0x5a>;
		actuator-mode = "LRA";
	};
};

/* The FLPR (RISC-V) core is not used: give its RAM and RRAM to the app core,
 * as Nordic samples do. The frame buffer alone needs 52 KB.
 */
&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000 0x40000>;
};

&rram_controller {
	/delete-node/ cpuflpr_sram;
	/delete-node/ cpuflpr_rram;
};

/* Watchdog, fed by the application thread (review pass 5). */
&wdt31 { status = "okay"; };
